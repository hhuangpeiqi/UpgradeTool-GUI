cmake_minimum_required(VERSION 3.21.1)
foreach(required ROCKUSB_DRIVER_CACHE_DIR ROCKUSB_DRIVER_DESTINATION)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/rockusb_driver_manifest.cmake")
file(MAKE_DIRECTORY "${ROCKUSB_DRIVER_CACHE_DIR}")
file(LOCK "${ROCKUSB_DRIVER_CACHE_DIR}/package.lock" GUARD PROCESS TIMEOUT 120)
if(NOT DEFINED ROCKUSB_DRIVER_SOURCE OR ROCKUSB_DRIVER_SOURCE STREQUAL "")
  set(ROCKUSB_DRIVER_SOURCE "$ENV{UPGRADE_TOOL_ROCKUSB_DRIVER}")
endif()
if(ROCKUSB_DRIVER_SOURCE STREQUAL "")
  set(archive "${ROCKUSB_DRIVER_CACHE_DIR}/DriverAssistant.zip")
  if(NOT EXISTS "${archive}")
    file(DOWNLOAD "${ROCKUSB_DRIVER_URL}" "${archive}.download" TLS_VERIFY ON TIMEOUT 180 STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      file(REMOVE "${archive}.download")
      message(FATAL_ERROR "Rockusb driver download failed: ${status}. Set UPGRADE_TOOL_ROCKUSB_DRIVER to the original extracted directory for offline packaging.")
    endif()
    file(SHA256 "${archive}.download" checksum)
    if(NOT checksum STREQUAL ROCKUSB_DRIVER_SHA256)
      file(REMOVE "${archive}.download")
      message(FATAL_ERROR "Downloaded Rockusb driver failed SHA256 verification")
    endif()
    file(RENAME "${archive}.download" "${archive}")
  endif()
  file(SHA256 "${archive}" checksum)
  if(NOT checksum STREQUAL ROCKUSB_DRIVER_SHA256)
    message(FATAL_ERROR "Cached Rockusb driver failed SHA256 verification")
  endif()
  set(extracted "${ROCKUSB_DRIVER_CACHE_DIR}/extracted")
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extracted}")
  file(GLOB_RECURSE installers "${extracted}/DriverInstall.exe")
  list(LENGTH installers count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Rockusb archive does not contain exactly one DriverInstall.exe")
  endif()
  list(GET installers 0 installer)
  get_filename_component(ROCKUSB_DRIVER_SOURCE "${installer}" DIRECTORY)
endif()
# Validate the entire source before copying anything into the package.
foreach(entry IN LISTS ROCKUSB_DRIVER_FILES)
  string(REPLACE "|" ";" fields "${entry}")
  list(GET fields 0 relative)
  list(GET fields 1 expected)
  if(NOT EXISTS "${ROCKUSB_DRIVER_SOURCE}/${relative}")
    message(FATAL_ERROR "Rockusb package file missing: ${relative}")
  endif()
  file(SHA256 "${ROCKUSB_DRIVER_SOURCE}/${relative}" checksum)
  if(NOT checksum STREQUAL expected)
    message(FATAL_ERROR "Rockusb package SHA256 mismatch: ${relative}")
  endif()
endforeach()
foreach(entry IN LISTS ROCKUSB_DRIVER_FILES)
  string(REPLACE "|" ";" fields "${entry}")
  list(GET fields 0 relative)
  get_filename_component(parent "${ROCKUSB_DRIVER_DESTINATION}/${relative}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  configure_file("${ROCKUSB_DRIVER_SOURCE}/${relative}" "${ROCKUSB_DRIVER_DESTINATION}/${relative}" COPYONLY)
endforeach()
message(STATUS "Prepared official Rockusb driver: ${ROCKUSB_DRIVER_DESTINATION}")
