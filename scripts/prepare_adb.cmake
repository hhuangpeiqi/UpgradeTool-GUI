cmake_minimum_required(VERSION 3.21.1)
# Called only by release packaging. ADB_ARCHIVE optionally supplies an offline ZIP.
foreach(required ADB_PLATFORM ADB_CACHE_DIR ADB_DESTINATION)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/adb_manifest.cmake")
if(ADB_PLATFORM STREQUAL "win")
  set(checksum "${ADB_WIN_SHA256}")
  set(runtime_files adb.exe AdbWinApi.dll AdbWinUsbApi.dll)
elseif(ADB_PLATFORM STREQUAL "darwin")
  set(checksum "${ADB_DARWIN_SHA256}")
  # This revision's ADB links only system libraries (including on Apple Silicon).
  set(runtime_files adb)
else()
  message(FATAL_ERROR "Unsupported ADB platform: ${ADB_PLATFORM}")
endif()
list(APPEND runtime_files NOTICE.txt source.properties)
file(MAKE_DIRECTORY "${ADB_CACHE_DIR}")
file(LOCK "${ADB_CACHE_DIR}/${ADB_PLATFORM}.lock" GUARD PROCESS TIMEOUT 120)
if(NOT DEFINED ADB_ARCHIVE OR ADB_ARCHIVE STREQUAL "")
  set(ADB_ARCHIVE "$ENV{UPGRADE_TOOL_ADB_ARCHIVE}")
endif()
if(ADB_ARCHIVE STREQUAL "")
  set(archive_name "platform-tools_r${ADB_REVISION}-${ADB_PLATFORM}.zip")
  set(ADB_ARCHIVE "${ADB_CACHE_DIR}/${archive_name}")
  if(NOT EXISTS "${ADB_ARCHIVE}")
    message(STATUS "Downloading pinned ADB ${ADB_REVISION} (${ADB_PLATFORM})")
    set(temporary "${ADB_ARCHIVE}.download")
    file(DOWNLOAD "${ADB_BASE_URL}/${archive_name}" "${temporary}"
      TLS_VERIFY ON TIMEOUT 120 STATUS download_status)
    list(GET download_status 0 code)
    if(NOT code EQUAL 0)
      file(REMOVE "${temporary}")
      message(FATAL_ERROR "ADB download failed: ${download_status}. Set UPGRADE_TOOL_ADB_ARCHIVE for offline packaging.")
    endif()
    file(SHA256 "${temporary}" downloaded_checksum)
    if(NOT downloaded_checksum STREQUAL checksum)
      file(REMOVE "${temporary}")
      message(FATAL_ERROR "Downloaded ADB archive failed SHA256 verification")
    endif()
    file(RENAME "${temporary}" "${ADB_ARCHIVE}")
  endif()
endif()
if(NOT EXISTS "${ADB_ARCHIVE}")
  message(FATAL_ERROR "ADB archive not found: ${ADB_ARCHIVE}")
endif()
file(SHA256 "${ADB_ARCHIVE}" actual_checksum)
if(NOT actual_checksum STREQUAL checksum)
  message(FATAL_ERROR "ADB archive failed SHA256 verification: ${ADB_ARCHIVE}")
endif()
set(extracted "${ADB_CACHE_DIR}/extract-${ADB_PLATFORM}")
file(REMOVE_RECURSE "${extracted}")
file(MAKE_DIRECTORY "${extracted}")
file(ARCHIVE_EXTRACT INPUT "${ADB_ARCHIVE}" DESTINATION "${extracted}")
file(READ "${extracted}/platform-tools/source.properties" properties)
if(NOT properties MATCHES "Pkg.Revision=${ADB_REVISION}([\r\n]|$)")
  message(FATAL_ERROR "ADB archive has an unexpected revision")
endif()
foreach(relative IN LISTS runtime_files)
  set(source "${extracted}/platform-tools/${relative}")
  if(NOT EXISTS "${source}")
    message(FATAL_ERROR "Missing ADB runtime file: ${relative}")
  endif()
endforeach()
file(REMOVE_RECURSE "${ADB_DESTINATION}")
foreach(relative IN LISTS runtime_files)
  get_filename_component(directory "${relative}" DIRECTORY)
  file(MAKE_DIRECTORY "${ADB_DESTINATION}/${directory}")
  file(COPY "${extracted}/platform-tools/${relative}" DESTINATION "${ADB_DESTINATION}/${directory}")
endforeach()
file(REMOVE_RECURSE "${extracted}")
message(STATUS "Prepared ADB ${ADB_REVISION}: ${ADB_DESTINATION}")
