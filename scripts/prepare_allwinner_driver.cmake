cmake_minimum_required(VERSION 3.21.1)
foreach(required ALLWINNER_DRIVER_CACHE_DIR ALLWINNER_DRIVER_DESTINATION)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/allwinner_driver_manifest.cmake")
file(MAKE_DIRECTORY "${ALLWINNER_DRIVER_CACHE_DIR}")
file(LOCK "${ALLWINNER_DRIVER_CACHE_DIR}/package.lock" GUARD PROCESS TIMEOUT 120)
if(NOT DEFINED ALLWINNER_DRIVER_SOURCE OR ALLWINNER_DRIVER_SOURCE STREQUAL "")
  set(ALLWINNER_DRIVER_SOURCE "$ENV{UPGRADE_TOOL_ALLWINNER_DRIVER}")
endif()
if(ALLWINNER_DRIVER_SOURCE STREQUAL "")
  set(archive "${ALLWINNER_DRIVER_CACHE_DIR}/PhoenixSuit.zip")
  if(NOT EXISTS "${archive}")
    file(DOWNLOAD "${ALLWINNER_DRIVER_URL}" "${archive}.download" TLS_VERIFY ON TIMEOUT 180 STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      file(REMOVE "${archive}.download")
      message(FATAL_ERROR "Allwinner driver download failed: ${status}. Set UPGRADE_TOOL_ALLWINNER_DRIVER to the original extracted directory for offline packaging.")
    endif()
    file(SHA256 "${archive}.download" checksum)
    if(NOT checksum STREQUAL ALLWINNER_DRIVER_SHA256)
      file(REMOVE "${archive}.download")
      message(FATAL_ERROR "Downloaded Allwinner driver failed SHA256 verification")
    endif()
    file(RENAME "${archive}.download" "${archive}")
  endif()
  file(SHA256 "${archive}" checksum)
  if(NOT checksum STREQUAL ALLWINNER_DRIVER_SHA256)
    message(FATAL_ERROR "Cached Allwinner driver failed SHA256 verification")
  endif()
  set(extracted "${ALLWINNER_DRIVER_CACHE_DIR}/extracted")
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extracted}")
  file(GLOB_RECURSE installers "${extracted}/InstallUSBDrv.exe")
  list(LENGTH installers count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Allwinner archive does not contain exactly one InstallUSBDrv.exe")
  endif()
  list(GET installers 0 installer)
  get_filename_component(ALLWINNER_DRIVER_SOURCE "${installer}" DIRECTORY)
endif()
# Validate the entire source before copying anything into the package.
foreach(entry IN LISTS ALLWINNER_DRIVER_FILES)
  string(REPLACE "|" ";" fields "${entry}")
  list(GET fields 0 relative)
  list(GET fields 1 expected)
  if(NOT EXISTS "${ALLWINNER_DRIVER_SOURCE}/${relative}")
    message(FATAL_ERROR "Allwinner package file missing: ${relative}")
  endif()
  file(SHA256 "${ALLWINNER_DRIVER_SOURCE}/${relative}" checksum)
  if(NOT checksum STREQUAL expected)
    message(FATAL_ERROR "Allwinner package SHA256 mismatch: ${relative}")
  endif()
endforeach()
foreach(entry IN LISTS ALLWINNER_DRIVER_FILES)
  string(REPLACE "|" ";" fields "${entry}")
  list(GET fields 0 relative)
  get_filename_component(parent "${ALLWINNER_DRIVER_DESTINATION}/${relative}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  configure_file("${ALLWINNER_DRIVER_SOURCE}/${relative}" "${ALLWINNER_DRIVER_DESTINATION}/${relative}" COPYONLY)
endforeach()
message(STATUS "Prepared official Allwinner driver: ${ALLWINNER_DRIVER_DESTINATION}")
