cmake_minimum_required(VERSION 3.21.1)
foreach(required QUALCOMM_DRIVER_CACHE_DIR QUALCOMM_DRIVER_DESTINATION)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/qualcomm_driver_manifest.cmake")
file(MAKE_DIRECTORY "${QUALCOMM_DRIVER_CACHE_DIR}")
file(LOCK "${QUALCOMM_DRIVER_CACHE_DIR}/package.lock" GUARD PROCESS TIMEOUT 120)
if(NOT DEFINED QUALCOMM_DRIVER_SOURCE OR QUALCOMM_DRIVER_SOURCE STREQUAL "")
  set(QUALCOMM_DRIVER_SOURCE "$ENV{UPGRADE_TOOL_QUALCOMM_DRIVER}")
endif()
if(QUALCOMM_DRIVER_SOURCE STREQUAL "")
  set(QUALCOMM_DRIVER_SOURCE "${QUALCOMM_DRIVER_CACHE_DIR}/${QUALCOMM_DRIVER_FILENAME}")
  if(NOT EXISTS "${QUALCOMM_DRIVER_SOURCE}")
    set(temporary "${QUALCOMM_DRIVER_SOURCE}.download")
    file(DOWNLOAD "${QUALCOMM_DRIVER_URL}" "${temporary}" TLS_VERIFY ON TIMEOUT 180 STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      file(REMOVE "${temporary}")
      message(FATAL_ERROR "Qualcomm driver download failed: ${status}. Set UPGRADE_TOOL_QUALCOMM_DRIVER for offline packaging.")
    endif()
    file(SHA256 "${temporary}" checksum)
    if(NOT checksum STREQUAL QUALCOMM_DRIVER_SHA256)
      file(REMOVE "${temporary}")
      message(FATAL_ERROR "Downloaded Qualcomm driver failed SHA256 verification")
    endif()
    file(RENAME "${temporary}" "${QUALCOMM_DRIVER_SOURCE}")
  endif()
endif()
if(NOT EXISTS "${QUALCOMM_DRIVER_SOURCE}")
  message(FATAL_ERROR "Qualcomm driver tool not found: ${QUALCOMM_DRIVER_SOURCE}")
endif()
file(SHA256 "${QUALCOMM_DRIVER_SOURCE}" checksum)
if(NOT checksum STREQUAL QUALCOMM_DRIVER_SHA256)
  message(FATAL_ERROR "Qualcomm driver tool failed SHA256 verification: ${QUALCOMM_DRIVER_SOURCE}")
endif()
file(MAKE_DIRECTORY "${QUALCOMM_DRIVER_DESTINATION}")
configure_file("${QUALCOMM_DRIVER_SOURCE}" "${QUALCOMM_DRIVER_DESTINATION}/${QUALCOMM_DRIVER_FILENAME}" COPYONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/windows/qualcomm-LICENSE.txt" "${QUALCOMM_DRIVER_DESTINATION}/LICENSE.txt" COPYONLY)
message(STATUS "Prepared official Qualcomm driver: ${QUALCOMM_DRIVER_DESTINATION}")
