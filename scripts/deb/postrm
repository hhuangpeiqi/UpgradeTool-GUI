#!/bin/sh
set -e
if [ "$1" = "purge" ]; then
    for RULE_NAME in 99-rk-rockusb-all.rules 99-allwinner.rules; do
        rm -f "/etc/udev/rules.d/$RULE_NAME"
    done
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger || true
    fi
fi
exit 0
