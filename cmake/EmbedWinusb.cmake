set(header "/* Generated WinUSB resources for the pinned libwdi. */\n#include <stdint.h>\n")
set(entries "")
set(index 0)
function(embed path name subdir)
  file(READ "${path}" bytes HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
  string(APPEND header "static const unsigned char file_${index}[] = {${bytes}0};\n")
  file(SIZE "${path}" size)
  string(APPEND entries "{\"${subdir}\",\"${name}\",${size},1577836800,file_${index}},\n")
  math(EXPR index "${index}+1")
  set(header "${header}" PARENT_SCOPE)
  set(entries "${entries}" PARENT_SCOPE)
  set(index "${index}" PARENT_SCOPE)
endfunction()
embed("${INSTALLER}" "installer_x64.exe" ".")
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}" DIRECTORY)
embed("${root}/scripts/windows/winusb.inf.in" "winusb.inf.in" "")
file(WRITE "${OUTPUT}.cat.in" "# Only the generated INF is included; WinUSB is supplied by Windows.\n")
embed("${OUTPUT}.cat.in" "winusb.cat.in" "")
string(APPEND header "struct res { char* subdir; char* name; size_t size; int64_t creation_time; const unsigned char* data; };\nstatic const struct res resource[] = {${entries}};\nstatic const int nb_resources = ${index};\n")
file(WRITE "${OUTPUT}" "${header}")
