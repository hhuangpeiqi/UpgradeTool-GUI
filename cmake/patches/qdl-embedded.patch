+/* Read a complete control packet, preserving any following packet or XML. */
+static int sahara_read_control(struct qdl_device *qdl, char *buf, size_t size,
+			       unsigned int timeout)
+{
+	size_t have = 0;
+	uint32_t length;
+	int n;
+
+	for (;;) {
+		if (qtq_cancelled())
+			return -ECANCELED;
+		n = qdl_read(qdl, buf + have, size - have, timeout);
+		if (n < 0)
+			return n == -ETIMEDOUT && have ? -EINVAL : n;
+		if (!n)
+			return -EINVAL;
+		have += n;
+		if (have >= 5 && !memcmp(buf, "<?xml", 5))
+			return (int)have;
+		if (have < 8)
+			continue;
+		length = sahara_le32((uint8_t *)buf + 4);
+		if (length < 8 || length > size)
+			return -EINVAL;
+		if (have < length)
+			continue;
+		if (have > length && qdl_push_back(qdl, buf + length, have - length) < 0)
+			return -ENOMEM;
+		return (int)length;
+	}
