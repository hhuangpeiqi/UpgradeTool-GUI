+    bool cancelling = false;
+    if (!transfer) return LIBUSB_ERROR_NO_MEM;
+    libusb_fill_bulk_transfer(transfer, usb->usb_handle, endpoint, data, length,
+                             qtq_usb_complete, &done, timeout);
+    ret = libusb_submit_transfer(transfer);
+    if (ret) { libusb_free_transfer(transfer); return ret; }
+    while (!done) {
+        struct timeval tick = { .tv_sec = 0, .tv_usec = 100000 };
+        if (qtq_cancelled() && !cancelling) {
+            libusb_cancel_transfer(transfer);
+            cancelling = true;
+        }
+        libusb_handle_events_timeout_completed(usb->context, &tick, &done);
+    }
+    if (actual) *actual = transfer->actual_length;
+    switch (transfer->status) {
+    case LIBUSB_TRANSFER_COMPLETED: ret = 0; break;
+    case LIBUSB_TRANSFER_TIMED_OUT: ret = LIBUSB_ERROR_TIMEOUT; break;
+    case LIBUSB_TRANSFER_NO_DEVICE: ret = LIBUSB_ERROR_NO_DEVICE; break;
+    case LIBUSB_TRANSFER_CANCELLED: ret = LIBUSB_ERROR_INTERRUPTED; break;
+    default: ret = LIBUSB_ERROR_IO; break;
+    }
+    libusb_free_transfer(transfer);
+    return ret;
